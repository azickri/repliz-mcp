# Configuration for the Repliz MCP server.
#
# Copy to .env and adjust. Real environment variables win over this file, so
# anything exported in the shell or set by your process manager takes priority.
#
# There are no credentials here, and there is no place to put any. Every user
# sends their own Repliz Access Key and Secret Key with each request, and the
# server holds none of its own — so a leak of this file gives away nothing.

# ─── Basics ─────────────────────────────────────────────────────────────────
PORT=5301

# Base URL of the Repliz Public API.
REPLIZ_BASE_URL=https://api.repliz.com

# ─── Capacity ───────────────────────────────────────────────────────────────
# Roughly 93 MB baseline + 1.8 MB per live session, so REPLIZ_MAX_SESSIONS is
# the main memory lever. 300 suits a 1 GB VPS (~630 MB worst case); raise it to
# about 1000 on 2 GB.
REPLIZ_MAX_SESSIONS=300

# Close a session after this many minutes with no request. Most MCP clients
# disconnect without saying so, and this is what reclaims their memory.
REPLIZ_SESSION_IDLE_MINUTES=30

# Requests allowed per IP per minute.
REPLIZ_RATE_LIMIT_PER_MINUTE=120

# ─── Reverse proxy ──────────────────────────────────────────────────────────
# Which proxies may set X-Forwarded-For, i.e. which address the rate limiter
# counts against. "loopback" is right when Nginx runs on the same host as this
# process. Trusting every hop ("true") would let callers forge the header for a
# fresh rate-limit bucket per request; trusting none ("false") behind Nginx
# would collapse every user into a single bucket.
REPLIZ_TRUST_PROXY=loopback

# Browser origins allowed to call /mcp. Unset means no CORS headers, which is
# correct while clients are server-side (Claude.ai, ChatGPT, the Anthropic API,
# Cursor). Only needed for a browser-based client.
# REPLIZ_ALLOWED_ORIGINS=https://claude.ai

# ─── Tuning (optional — defaults are usually fine) ──────────────────────────
# Timeout for outbound calls to the Repliz API, in seconds (default 30).
# REPLIZ_REQUEST_TIMEOUT_SECONDS=30

# How long a verified credential pair is cached, in minutes (default 5).
# Longer means fewer verification calls, but a revoked key keeps working longer.
# REPLIZ_AUTH_CACHE_MINUTES=5

# Largest file repliz_upload_file will copy through the server, in MB
# (default 100). Buffered in memory, so this bounds the per-upload spike.
# REPLIZ_MAX_UPLOAD_MB=100

# Hosts accepted as presigned-upload targets (comma-separated). Only change
# this if Repliz storage moves off Cloudflare R2.
# REPLIZ_UPLOAD_HOSTS=r2.cloudflarestorage.com,storage.repliz.com
