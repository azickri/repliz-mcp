{
  "name": "repliz-mcp",
  "version": "2.0.0",
  "description": "Hosted Model Context Protocol (MCP) server for the Repliz Public API. Users connect by URL and send their own Repliz Access Key and Secret Key \u2014 nothing to install or deploy.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "repliz",
    "social-media",
    "automation",
    "ai"
  ],
  "author": "Repliz",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.21",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "private": true,
  "overrides": {
    "fast-uri": "^3.1.8",
    "body-parser": "^1.20.8",
    "@hono/node-server": "^1.19.15",
    "hono": "^4.13.8",
    "ip-address": "^10.7.2",
    "qs": "^6.16.0"
  }
}
